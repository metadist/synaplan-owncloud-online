{
    "name": "synaplan/owncloud-online-integration",
    "description": "Synaplan AI Integration for owncloud.online",
    "type": "owncloud-app",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\OcoSynaplan\\": "lib/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1"
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix"
    }
}
